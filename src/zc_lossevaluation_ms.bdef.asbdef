// -----------------------------------------------------------------------------
// [Behavior 역할] Interface Behavior를 서비스용 Projection 계층에 전달한다.
// 별도 구현 없이 필요한 Association만 use하여 Fiori 탐색을 허용한다.
// -----------------------------------------------------------------------------
projection;
strict ( 2 );

// List/Object Page의 Root 엔티티 Behavior.
define behavior for ZC_LossEvaluation_MS
  alias Evaluation
{
  // Object Page에서 Header → PO Item / 자재별 Result 탐색을 허용한다.
  use association _Items;
  use association _Results;
}

// PO Item 소비 엔티티의 부모 탐색을 허용한다.
define behavior for ZC_LossEvaluationItem_MS
  alias EvaluationItem
{
  use association _Evaluation;
}

// 자재별 Result 소비 엔티티의 부모 탐색을 허용한다.
define behavior for ZC_LossEvaluationResult_MS
  alias EvaluationResult
{
  use association _Evaluation;
}